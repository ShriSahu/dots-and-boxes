rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Rooms (online games) ──────────────────────────────────────
    match /rooms/{roomCode} {
      // Any authenticated user can read
      allow read: if request.auth != null;
      // Only host or guest can write/update (checked via currentPlayerUid or status transitions)
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false; // No deletes
    }

    // ── Ultimate Tic-Tac-Toe rooms (online games) ──────────────────
    match /ttt_rooms/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Matchmaking (quick match waiting pool) ────────────────────
    match /matchmaking/{uid} {
      // Any authenticated user can read all docs (needed to find a waiting partner)
      allow read: if request.auth != null;
      // Own writes OR match-resolution writes (status → matched, from transaction)
      allow create, update: if request.auth != null
        && (request.auth.uid == uid
            || request.resource.data.status == 'matched');
      // No deletes (audit trail)
      allow delete: if false;
    }

    // ── Users (profile, theme, coins) ─────────────────────────────
    match /users/{uid} {
      // Readable by any authenticated user — needed for the leaderboard and
      // for reading an opponent's ELO when settling a ranked game. No PII is
      // stored here (anonymous auth, display name is user-chosen).
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Coin Transactions (audit trail) ────────────────────────────
    match /coinTransactions/{txId} {
      // Users can only read their own transactions
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      // Only backend (signed in) can create; no manual writes
      allow create, update, delete: if false;
    }
  }
}
